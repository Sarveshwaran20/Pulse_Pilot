# PulsePilot Local-First Configuration
# All operations run strictly on localhost. No cloud API keys or external OAuth tokens required.

VAULT_HOST=127.0.0.1
VAULT_PORT=8000
MCP_PORT=8002
DASHBOARD_PORT=5173

# CORS Origins (strictly local)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8002,http://127.0.0.1:8002
